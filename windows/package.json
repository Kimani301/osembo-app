{
  "name": "osembo-school-system-windows",
  "version": "1.0.0",
  "description": "Osembo School System for Windows",
  "author": "Osembo School",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.osembo.school",
    "productName": "Osembo",
    "files": ["main.js", "app/**"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Osembo-Setup.exe"
    }
  }
}
